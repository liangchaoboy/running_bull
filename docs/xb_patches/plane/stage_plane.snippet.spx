// --- inside forever, after plant block, add plane autofire ---
		if running && mapId == 7 {
			planeFireT = planeFireT + 0.02
			if planeFireT >= 0.14 {
				planeFireT = 0
				peaLane = laneHome
				broadcast "planefire"
			}
		}

// --- Key0 (menu) ---
onKey Key0, => {
	if inMenu {
		mapId = 7
		broadcast "applymap"
		broadcast "showmenu"
	}
}


// --- ad complete branch (when adT >= 2) add ---
//				adContinue = 1

// --- onMsg "hit" replace ---
onMsg "hit", => {
	if running && !over && !adOn && invulnT <= 0 && !(mapId == 6 && wallT > 0) {
		if adContinue >= 1 {
			running = false
			over = true
			broadcast "gameover"
		} else {
			running = false
			adOn = true
			adSkip = false
			adT = 0
			inputLock = 3
			adLine = "撞到了！\n看完广告越过障碍\n按2认栽结算"
			broadcast "ad"
		}
	}
}

// --- Key2: first skip = 认栽 (tighten) ---
onKey Key2, => {
	if adOn {
		// any skip / 认栽 → settle
		adOn = false
		adSkip = false
		adT = 0
		adSkipCount = 0
		running = false
		over = true
		adLine = "认栽结算"
		broadcast "ad"
		broadcast "gameover"
	} else if inMenu {
		hero = 2
		broadcast "showmenu"
	}
}


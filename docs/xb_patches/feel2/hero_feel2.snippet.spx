# feel2 — lane snap (paste into each hero forever lane block)
# Replace snapK = 0.88 / boost 0.48 with:

				laneHome = tx
				tx = tx + curveBend*0.25
				snapK = 0.94
				if boostT > 0 {
					snapK = 0.58
				}
				if xpos < tx-5 || xpos > tx+5 {
					setXpos xpos + (tx-xpos)*snapK
				} else {
					setXpos tx
				}

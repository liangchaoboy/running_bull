# road3 — stronger curve lean + section enter say
# Replace: tx = tx + curveBend*0.25

				laneHome = tx
				tx = tx + curveBend*0.42
				snapK = 0.94
				if boostT > 0 {
					snapK = 0.58
				}
				if xpos < tx-5 || xpos > tx+5 {
					setXpos xpos + (tx-xpos)*snapK
				} else {
					setXpos tx
				}

# Add once per hero (outside forever):
onMsg "secbridge" => {
	say "过桥", 1.2
}
onMsg "seccave" => {
	say "进入山洞", 1.2
}
